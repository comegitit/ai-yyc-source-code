Redirect 301 /hca.html /hcai.html

RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?ai-yyc\.net$ [NC]
RewriteRule ^(.*)$ https://ai-yyc.com/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.ai-yyc\.com$ [NC]
RewriteRule ^(.*)$ https://ai-yyc.com/$1 [R=301,L]
ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On

  # Content that changes on deploy: keep it short.
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"

  # Assets whose filenames never change: keep them long.
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

