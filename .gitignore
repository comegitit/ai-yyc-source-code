# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*~
.vscode/
.vs/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Logs / temp
*.log
*.tmp

# Local tooling
launch-claude-*.bat

# Deployment artefacts: rebuilt from the tree, never part of it.
# The zip must stay ignored so a rebuild cannot package the previous one.
ai-yyc-deploy-*.zip
ai-yyc-DEPLOY-INSTRUCTIONS.*

# Claude Code local tooling and worktrees
.claude/

# Word lock files left behind by an open .docx
~$*

# Imported reference copy. The agentic job-search project owns this file and
# tracks it; keeping a second tracked copy here would guarantee the two drift.
# Kept locally for reference, and never uploaded: in the web root it would be
# publicly readable.
career_profile.json

# Local backups kept while reworking the resume. Superseded copies,
# never uploaded, and not worth version control since git already holds the
# history they were made to preserve.
*_old_2026.docx
*_old_2026.pdf

# Self-employment / consulting strategy briefs, in every format. Working
# notes for Roy, not site content: they carry candid self-assessment, pricing
# floors and named prospects. This repo is public, and git history is forever,
# so these stay local. They also sit in the web root, so they must never reach
# public_html.
Self-employment-Research-*

# Briefs at the repo root are kept as a tracked .md plus a local .docx: the
# markdown is what gets reviewed and diffed, the Word copy is for reading and
# printing. Root-anchored on purpose, so the tracked resumes in documents/
# are unaffected.
/*.docx
